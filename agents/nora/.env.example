PORT=8000
NESTJS_API_URL=http://localhost:3001
# Base para los enlaces a reportes que Nora entrega en el chat y por WhatsApp.
FRONTEND_URL=http://localhost:3000

NORA_LLM_PROVIDER=openai
OPENAI_API_KEY=replace-me
# Un turno de pedido encadena 4-5 llamadas de ~9k tokens (26 tools + system
# prompt): con gpt-4o en tier 1 (30k TPM) el turno de confirmacion siempre da
# 429. Si no se sube el tier de la cuenta, usar gpt-4o-mini (200k TPM).
OPENAI_MODEL=gpt-4o
NORA_LLM_TEMPERATURE=0.3
# Reintentos ante el 429 por TPM (transitorio, se resuelve en ~1s).
NORA_LLM_MAX_RETRIES=6
# Timeout por llamada al LLM en segundos. El default del SDK de OpenAI es 600s:
# con NORA_LLM_MAX_RETRIES=6 una llamada colgada bloquea el turno durante horas.
# Una llamada sana tarda menos de 15s, asi que 60s solo corta lo que ya murio.
NORA_LLM_REQUEST_TIMEOUT=60
# Tope de tokens de la respuesta. Nora contesta por chat/WhatsApp (parrafos
# cortos) o con un tool call; el tope evita que una generacion en loop corra
# minutos y cueste de mas.
NORA_LLM_MAX_TOKENS=2000

# Optional providers.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
