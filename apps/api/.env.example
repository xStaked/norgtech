DATABASE_URL=postgresql://norgtech:norgtech_dev@localhost:5432/norgtech
JWT_SECRET=dev-secret
FRONTEND_URL=http://localhost:3000
PORT=3001

# Nora FastAPI service used by the WhatsApp routing bridge.
NORA_API_URL=http://localhost:8000

# Kapso / Meta WhatsApp Cloud API.
KAPSO_API_BASE_URL=https://api.kapso.ai/meta/whatsapp
KAPSO_API_KEY=replace-me
KAPSO_PHONE_NUMBER_ID=replace-me

# Secreto del webhook de Kapso. Autentica POST /whatsapp/webhooks/kapso:
# FIRMA (X-Kapso-Signature) o TOKEN compartido (X-Webhook-Token).
# Sin esta variable el webhook queda sin autenticación (fail-open, con aviso en boot).
KAPSO_WEBHOOK_SECRET=replace-me

# Modo de seguridad del webhook: strict (default, 401 sin credenciales válidas)
# o warn (no bloquea; solo loguea warning mientras la transición se valida).
WEBHOOK_SECURITY=strict

# Local-only helper for resolving commercial/admin senders by phone.
# Format: phone:userId,phone:userId
WHATSAPP_TEST_USER_PHONE_MAP=

# Resend (correos transaccionales: recuperación de contraseña).
RESEND_API_KEY=replace-me
RESEND_FROM="Norgtech <no-reply@norgtech.co>"
